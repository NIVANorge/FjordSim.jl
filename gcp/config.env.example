# Copy to gcp/config.env and fill in — that is the only file you edit, and it is git-ignored
# because it names your project and bucket, which are deployment facts rather than package facts.
# "One-time setup" in gcp/README.md walks through it.
#
# Every value below is also overridable from the environment, so a one-off run needs no edit:
#   BUCKET=gs://other-bucket gcp/fjordsim-gcp run --config oslofjorden --steps run_simulation

# --- Where things live -------------------------------------------------------------------------
# The project everything is billed to: `gcloud config get-value project`, or whoever gave you access.
PROJECT_ID=CHANGE-ME

# Put the registry and the VMs in the region the bucket is already in — cross-region reads are slow
# and billed as egress:
#   gcloud storage buckets describe gs://YOUR-BUCKET --format='value(location)'
REGION=europe-west4
ZONE=europe-west4-a

# The bucket holding staged inputs, results and uploaded configs. An existing one is fine; if you
# need to create it, gcp/README.md has the command.
BUCKET=gs://CHANGE-ME

# Artifact Registry repository to push the image to, and the image name within it. Many accounts
# cannot run `gcloud artifacts repositories list` even when they can push, so ask for the
# repository name rather than guessing if the project already has one.
AR_REPO=images
IMAGE=fjordsim
IMAGE_TAG=latest

# By default the image URI is built as REGION-docker.pkg.dev/PROJECT_ID/AR_REPO/IMAGE:IMAGE_TAG.
# Set IMAGE_URI explicitly when the registry you can push to is in a different project or region
# than the VMs — access is often granted per repository rather than per project, so the two need
# not line up. Only the image is affected: it is pulled once per VM, whereas the bucket is read
# and written throughout a run, so it is the bucket that must share the VMs' region.
# The VMs' service account then needs artifactregistry.reader on *that* repository's project.
# IMAGE_URI=europe-west1-docker.pkg.dev/other-project/other-repo/fjordsim:latest

# --- Identity ----------------------------------------------------------------------------------
# The service account the VMs run as. Needs objectAdmin on BUCKET, artifactregistry.reader,
# compute.instanceAdmin.v1 (so a finished job can delete its own VM) and, if any step calls
# `add_rivers`, secretmanager.secretAccessor. Substitute PROJECT_ID for CHANGE-ME below if you
# create it with the name gcp/README.md uses.
SERVICE_ACCOUNT=fjordsim-runner@CHANGE-ME.iam.gserviceaccount.com

# Secret Manager secret holding the NVE HydAPI key. Only `add_rivers` reads it; leave as-is if you
# never run that step on GCP. Free key: https://hydapi.nve.no/Users
NVE_API_KEY_SECRET=fjordsim-nve-api-key

# --- VM image ----------------------------------------------------------------------------------
# A Deep Learning VM: NVIDIA driver, Docker and the container toolkit are already installed, so the
# startup script has no driver bootstrap to do. Google retires these families periodically — list
# the current ones with:
#   gcloud compute images list --project=deeplearning-platform-release --filter="family~common-cu"
VM_IMAGE_FAMILY=common-cu129-ubuntu-2204-nvidia-580
VM_IMAGE_PROJECT=deeplearning-platform-release

# --- Machine shapes ----------------------------------------------------------------------------
# Simulation VMs. An L4 has 24 GB, comfortably above what the Oslofjord grid needs, and is the
# cheapest accelerator that makes a year-long run practical. a2-highgpu-1g + type=nvidia-tesla-a100
# is the step up when a run is too slow rather than too large. Whichever you pick needs GPU quota
# in REGION, which is per accelerator type and starts at zero on a new project.
GPU_MACHINE_TYPE=g2-standard-8
GPU_ACCELERATOR=type=nvidia-l4,count=1
GPU_BOOT_DISK_SIZE=200GB

# Prep VMs. No accelerator: every download_* and prepare_* step is network- or CPU-bound, and
# `architecture = :auto` resolves to CPU() when there is no GPU, so the same config just works.
# The disk must hold the raw sources — the Geonorge FileGDB alone is 4.5 GB.
CPU_MACHINE_TYPE=n2-standard-8
CPU_BOOT_DISK_SIZE=300GB

# Staged inputs and the NetCDF snapshots a run writes both live on the boot disk. pd-ssd is the
# step up if snapshot writing shows up in the timings.
BOOT_DISK_TYPE=pd-balanced

# Backstop so a hung job cannot bill indefinitely even if the self-delete never runs.
MAX_RUN_DURATION=24h
