# Copy to gcp/config.env and fill in. Git-ignored: it names your deployment, not the package.
# Every value is overridable per invocation:
#   BUCKET=gs://other gcp/fjordsim-gcp run --config oslofjorden --steps run_simulation

PROJECT_ID=CHANGE-ME
BUCKET=gs://CHANGE-ME

# Access to Artifact Registry is granted per repository, so the one you can push to may be in
# another project or region. Both `bootstrap` and the remote run script authenticate against the
# host in this URI, so nothing else has to line up with it.
IMAGE_URI=REGION-docker.pkg.dev/PROJECT/REPO/fjordsim:latest

# The Cloud Run jobs that create or start the VM, the region they live in, and the single instance
# they manage. Ask the admin for these — you cannot list them. JOB_REGION is only ever passed to
# `gcloud run jobs execute`; the VM's own zone is discovered, and the bucket's region is its own
# business (keep it near the VM: that traffic repeats all run long).
JOB_REGION=europe-west4
VM_NAME=fjordsim-gpu
LAUNCH_JOB_SPOT=fjordsim-launch-spot
LAUNCH_JOB_STANDARD=fjordsim-launch-standard

# Not settings, on purpose:
#   machine type, GPU, disk, run duration — owned by the launcher jobs; changing one is an
#     admin request (see "Asking the admin" in gcp/README.md)
#   ZONE            — discovered from the running instance
#   SERVICE_ACCOUNT — the job picks the VM's identity; `bootstrap` reads it from the metadata
#                     server when it needs to name one
#   NVE_API_KEY     — taken from your environment by `run`, not from Secret Manager
