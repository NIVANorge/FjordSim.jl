# Copy to gcp/config.env and fill in. Git-ignored: it names your deployment, not the package.
# Every value is overridable per invocation:
#   BUCKET=gs://other gcp/fjordsim-gcp run --config examples/oslofjorden/oslofjorden.jl --steps run_simulation

PROJECT_ID=CHANGE-ME
BUCKET=gs://CHANGE-ME

# Access to Artifact Registry is granted per repository, so the one you can push to may be in
# another project or region. Both `bootstrap` and the remote run script authenticate against the
# host in this URI, so nothing else has to line up with it.
IMAGE_URI=REGION-docker.pkg.dev/PROJECT/REPO/fjordsim:latest

# The GPU VM, and the CPU-only preprocessing VMs PREP_VM_PREFIX-1 ... PREP_VM_PREFIX-N. Leave the
# prefix empty without preprocessing VMs.
VM_NAME=fjordsim-gpu
PREP_VM_PREFIX=fjordsim-prep

# Job mode: Cloud Run jobs that an admin set up create, start and stop the VMs, and the names come
# from the admin (gcp/README.md, "Job mode"). JOB_REGION is only ever passed to
# `gcloud run jobs execute`. Leave all of these empty for direct mode.
JOB_REGION=
LAUNCH_JOB_SPOT=
LAUNCH_JOB_STANDARD=
LAUNCH_JOB_PREP=
STOP_JOB_PREP=

# Direct mode: `up` creates the VMs itself, in the first of ZONES with capacity (comma-separated,
# tried in order), from Ubuntu 22.04 (gcp/README.md, "Direct mode"). Disk sizes are in GB.
# GPU_ACCELERATOR is for machine types without a built-in GPU, e.g. type=nvidia-tesla-t4,count=1
# with an n1 type; a g2 type has its L4 already. SERVICE_ACCOUNT empty means the project's default
# compute service account.
ZONES=
GPU_MACHINE_TYPE=
GPU_ACCELERATOR=
GPU_DISK_SIZE=
PREP_MACHINE_TYPE=
PREP_DISK_SIZE=
SERVICE_ACCOUNT=

# Not settings, on purpose:
#   ZONE        — discovered from the running instance
#   NVE_API_KEY — taken from your environment by `run`, not from Secret Manager
# and in job mode the machine, GPU, disk and service account, which belong to the launch jobs.
