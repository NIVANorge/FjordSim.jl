# Copy to gcp/config.env and fill in. Git-ignored: it names your deployment, not the package.
# Every value is overridable per invocation:
#   BUCKET=gs://other gcp/fjordsim-gcp run --vm l4 --config examples/oslofjorden/oslofjorden.jl --steps run_simulation

PROJECT_ID=CHANGE-ME
BUCKET=gs://CHANGE-ME

# Access to Artifact Registry is granted per repository, so the one you can push to may be in
# another project or region. Both `bootstrap` and the remote run script authenticate against the
# host in this URI, so nothing else has to line up with it.
IMAGE_URI=REGION-docker.pkg.dev/PROJECT/REPO/fjordsim:latest

# The GPU VMs are GPU_VM_PREFIX-KIND, one per kind of GPU_KINDS (`--vm l4`), and the CPU-only
# preprocessing VMs PREP_VM_PREFIX-1 ... PREP_VM_PREFIX-N (`--vm 1`). GPU_KINDS pairs each kind with
# a machine type that has its GPU built in. Leave PREP_VM_PREFIX empty without preprocessing VMs.
GPU_VM_PREFIX=fjordsim-gpu
GPU_KINDS="l4=g2-standard-8 a100=a2-highgpu-1g"
PREP_VM_PREFIX=fjordsim-prep

# `up` creates the VMs in the first of ZONES with capacity (comma-separated, tried in order), from
# Ubuntu 22.04 (gcp/README.md, "The deployment model"). Disk sizes are in GB.
# SERVICE_ACCOUNT empty means the project's default compute service account.
ZONES=
GPU_DISK_SIZE=
PREP_MACHINE_TYPE=
PREP_DISK_SIZE=
SERVICE_ACCOUNT=

# Not settings, on purpose:
#   ZONE        — discovered from the running instance
#   NVE_API_KEY, VANNMILJO_API_KEY — taken from your environment by `run`, not from Secret Manager
